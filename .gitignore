# playwright-cli session artifacts (snapshots, screenshots) generated by karta-validate
.playwright-cli/
.karta-validate/

# Python bytecode cache (e.g. from validate_plugin.py importing the sync_* scripts)
__pycache__/

# Pi package development dependencies
node_modules/

.DS_Store

# Local Pi agent settings: machine-specific skill enablement, never shared.
# Committing this file would disable the karta skills for every consumer.
.pi/settings.json
