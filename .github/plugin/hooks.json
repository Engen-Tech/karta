{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "powershell": "& \"$env:PLUGIN_ROOT\\.codex-plugin\\hooks\\launch_hook.ps1\" \".codex-plugin/hooks/scripts/guard_binder_immutability.py\" Plugin; exit $LASTEXITCODE",
            "bash": "sh -c 'p=\"${PLUGIN_ROOT}/.codex-plugin/hooks/scripts/guard_binder_immutability.py\"; [ -f \"$p\" ] && exec python3 \"$p\"; exit 0'",
            "timeoutSec": 30
          },
          {
            "type": "command",
            "powershell": "& \"$env:PLUGIN_ROOT\\.codex-plugin\\hooks\\launch_hook.ps1\" \".codex-plugin/hooks/scripts/guard_pack_write.py\" Plugin; exit $LASTEXITCODE",
            "bash": "sh -c 'p=\"${PLUGIN_ROOT}/.codex-plugin/hooks/scripts/guard_pack_write.py\"; [ -f \"$p\" ] && exec python3 \"$p\"; exit 0'",
            "timeoutSec": 60
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "powershell": "& \"$env:PLUGIN_ROOT\\.codex-plugin\\hooks\\launch_hook.ps1\" \".codex-plugin/hooks/scripts/guard_auditor_dispatch.py\" Plugin; exit $LASTEXITCODE",
            "bash": "sh -c 'p=\"${PLUGIN_ROOT}/.codex-plugin/hooks/scripts/guard_auditor_dispatch.py\"; [ -f \"$p\" ] && exec python3 \"$p\"; exit 0'",
            "timeoutSec": 30
          },
          {
            "type": "command",
            "powershell": "& \"$env:PLUGIN_ROOT\\.codex-plugin\\hooks\\launch_hook.ps1\" \".codex-plugin/hooks/scripts/guard_gate_dispatch.py\" Plugin; exit $LASTEXITCODE",
            "bash": "sh -c 'p=\"${PLUGIN_ROOT}/.codex-plugin/hooks/scripts/guard_gate_dispatch.py\"; [ -f \"$p\" ] && exec python3 \"$p\"; exit 0'",
            "timeoutSec": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "powershell": "& \"$env:PLUGIN_ROOT\\.codex-plugin\\hooks\\launch_hook.ps1\" \".codex-plugin/hooks/scripts/guard_pack_write.py\" Plugin; exit $LASTEXITCODE",
            "bash": "sh -c 'p=\"${PLUGIN_ROOT}/.codex-plugin/hooks/scripts/guard_pack_write.py\"; [ -f \"$p\" ] && exec python3 \"$p\"; exit 0'",
            "timeoutSec": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "powershell": "& \"$env:PLUGIN_ROOT\\.codex-plugin\\hooks\\launch_hook.ps1\" \".codex-plugin/hooks/scripts/guard_delivery_stop.py\" Plugin; exit $LASTEXITCODE",
            "bash": "sh -c 'p=\"${PLUGIN_ROOT}/.codex-plugin/hooks/scripts/guard_delivery_stop.py\"; [ -f \"$p\" ] && exec python3 \"$p\"; exit 0'",
            "timeoutSec": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "powershell": "& \"$env:PLUGIN_ROOT\\.codex-plugin\\hooks\\launch_hook.ps1\" \".codex-plugin/hooks/scripts/guard_subagent_whiff.py\" Plugin; exit $LASTEXITCODE",
            "bash": "sh -c 'p=\"${PLUGIN_ROOT}/.codex-plugin/hooks/scripts/guard_subagent_whiff.py\"; [ -f \"$p\" ] && exec python3 \"$p\"; exit 0'",
            "timeoutSec": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "powershell": "& \"$env:PLUGIN_ROOT\\.codex-plugin\\hooks\\launch_hook.ps1\" \".codex-plugin/hooks/scripts/inject_karta_status.py\" Plugin; exit $LASTEXITCODE",
            "bash": "sh -c 'p=\"${PLUGIN_ROOT}/.codex-plugin/hooks/scripts/inject_karta_status.py\"; [ -f \"$p\" ] && exec python3 \"$p\"; exit 0'",
            "timeoutSec": 30
          }
        ]
      }
    ]
  }
}
